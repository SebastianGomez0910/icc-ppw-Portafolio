{
  "kind": "collectionType",
  "collectionName": "proyectos",
  "info": {
    "singularName": "proyecto",
    "pluralName": "proyectos",
    "displayName": "Proyecto"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "shortDescription": {
      "type": "text"
    },
    "fullDescription": {
      "type": "blocks"
    },
    "projectType": {
      "type": "enumeration",
      "enum": [
        "Academico",
        "Personal",
        "Laboral",
        "Simulado"
      ]
    },
    "teechnologies": {
      "type": "string"
    },
    "repositorioUrl": {
      "type": "string"
    },
    "demoUrl": {
      "type": "string"
    },
    "isFeatured": {
      "type": "boolean",
      "default": false
    },
    "mainImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    }
  }
}
